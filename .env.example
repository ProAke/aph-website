# ---- MariaDB (new database for the Nuxt rewrite) ----
NUXT_DB_HOST=127.0.0.1
NUXT_DB_PORT=3306
NUXT_DB_NAME=aph_website
NUXT_DB_USER=aph
NUXT_DB_PASSWORD=aph_secret
MARIADB_ROOT_PASSWORD=root_secret

# auto = use MariaDB when reachable, otherwise the bundled snapshot
# json = always use server/data/catalog.json (no DB required)
APH_DATA_SOURCE=auto

# WordPress source used by `npm run import:wp`
WP_BASE=https://www.aph-ita.co.th

# ---- zero-downtime migration (see docs/MIGRATION-ZERO-DOWNTIME.md) ----
# Origin of the still-running WordPress site (compat layer + old media uploads).
# Remove only after WordPress is decommissioned.
NUXT_LEGACY_ORIGIN=https://www.aph-ita.co.th

# canonical origin used by sitemap.xml / robots.txt
NUXT_PUBLIC_SITE_URL=https://www.aph-ita.co.th

# analytics continuity (same GTM container / GA4 property as WordPress)
NUXT_PUBLIC_GTM_ID=
NUXT_PUBLIC_GA_ID=

# cut-over day: 'woo' renders ฿0.00 exactly like WooCommerce, then switch back to 'quote'
NUXT_PUBLIC_ZERO_PRICE_STYLE=quote

# staging sub-domain (new.aph-ita.co.th): 1 = keep every search engine out
# (X-Robots-Tag + meta robots + robots.txt Disallow: /). Must be 0 on production.
# See docs/SUBDOMAIN-SETUP.md
NUXT_PUBLIC_ROBOTS_NOINDEX=0
