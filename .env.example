# ---- MariaDB (new database for the Nuxt rewrite) ----
NUXT_DB_HOST=127.0.0.1
NUXT_DB_PORT=3306
NUXT_DB_NAME=aph_website
NUXT_DB_USER=aph
NUXT_DB_PASSWORD=aph_secret
MARIADB_ROOT_PASSWORD=root_secret

# auto = use MariaDB when reachable, otherwise the bundled snapshot
# json = always use server/data/catalog.json (no DB required)
APH_DATA_SOURCE=auto

# WordPress source used by `npm run import:wp`
WP_BASE=https://www.aph-ita.co.th
