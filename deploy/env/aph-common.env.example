# Shared by every Nuxt instance (aph-nuxt@3000, @3010 …)
#   sudo install -m 640 -o root -g aph deploy/env/aph-common.env.example /etc/aph/aph-common.env
NODE_ENV=production

# ── database (the NEW MariaDB, never the WordPress one) ───────────────────
NUXT_DB_HOST=127.0.0.1
NUXT_DB_PORT=3306
NUXT_DB_NAME=aph_website
NUXT_DB_USER=aph
NUXT_DB_PASSWORD=CHANGE_ME

# ── compatibility layer: WordPress stays alive until decommission ─────────
# Required, otherwise /my-account, /wishlist, /compare, /wp-admin return 404.
NUXT_LEGACY_ORIGIN=https://www.aph-ita.co.th

# ── canonical + analytics: always the production origin/IDs ───────────────
NUXT_PUBLIC_SITE_URL=https://www.aph-ita.co.th
NUXT_PUBLIC_GTM_ID=
NUXT_PUBLIC_GA_ID=
NUXT_PUBLIC_ZERO_PRICE_STYLE=woo
