# staging.aph-ita.co.th — internal QA (Basic Auth in nginx)
#   sudo install -m 640 -o root -g aph deploy/env/aph-nuxt-3000.env.example /etc/aph/aph-nuxt-3000.env
PORT=3000
NITRO_PORT=3000

# CRITICAL: keeps robots.txt as "Disallow: /" and adds meta robots + X-Robots-Tag
NUXT_PUBLIC_ROBOTS_NOINDEX=1
