#   sudo install -m 640 -o root -g aph deploy/env/aph-nuxt-3010.env.example /etc/aph/aph-nuxt-3010.env
PORT=3010
NITRO_PORT=3010

# CRITICAL: no password here, so this flag is the only thing keeping Google out
# (nginx adds X-Robots-Tag as well; both must stay on until cut-over)
NUXT_PUBLIC_ROBOTS_NOINDEX=1
